PORT=3000
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@HOST/shelflife?retryWrites=true&w=majority
# Local Compose alternative: mongodb://localhost:27017/shelflife?replicaSet=rs0
MONGODB_URI=
# Long random value, 32 characters minimum. Example: openssl rand -hex 32
JWT_SECRET=
# Allowed browser origins, separated by commas. localhost and 127.0.0.1 are different origins.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SEED_LIBRARIAN_EMAIL=librarian@example.edu
SEED_LIBRARIAN_PASSWORD=
